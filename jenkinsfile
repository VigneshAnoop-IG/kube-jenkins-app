pipeline {
    agent any

    stages {
        stage('checkout') {
            steps {
                checkout scm
            }
        }

        stage('compile') {
            steps {
                bat 'mvn clean compile'
            }
        }

        stage('package') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('docker build') {
            steps {
                bat 'docker build -t kube-jenkins-app:%BUILD_NUMBER% .'
            }
        }
    }
}
``
